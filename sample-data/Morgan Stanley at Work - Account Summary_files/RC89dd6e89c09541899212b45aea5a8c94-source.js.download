_satellite.__registerScript('https://assets.adobedtm.com/b124caa02ab9/3e36902c0620/207482a4df9e/RC89dd6e89c09541899212b45aea5a8c94-source.js', "(function () {\n  const maxAttempts = 10;  // give it up to ~1000ms on init\n  const interval = 100;\n \n  \n  function deleteAdobeCookies() {\n  var cookies = document.cookie.split(\";\");\n\n  var domains = [\n    location.hostname,\n    \".\" + location.hostname,\n    \".\" + location.hostname.split(\".\").slice(-2).join(\".\")\n  ];\n\n  cookies.forEach(function(cookie) {\n    var name = cookie.split(\"=\")[0].trim();\n\n    if (\n      name.indexOf(\"AMCV\") === 0 ||\n      name.indexOf(\"AMCVS\") === 0 ||\n      name.indexOf(\"s_\") === 0 ||\n      name === \"demdex\" || name === \"at_check\" || name === \"mbox\"\n    ) {\n      domains.forEach(function(domain) {\n        document.cookie =\n          name +\n          \"=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=\" +\n          domain +\n          \";\";\n      });\n\n      // Also try without domain\n      document.cookie =\n        name +\n        \"=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\n    }\n  });\n}\n\n  \n  const applyFromGroups = (groupsStr, source) => {\n    _satellite.logger.log(source + \" OnetrustActiveGroups=\" + groupsStr + \" => \" + source);\n\n    if (groupsStr === \"in\") {\n      adobe.optIn.approveAll();\n    } else {\n      adobe.optIn.denyAll();\n      deleteAdobeCookies();  \n    }\n  };\n\n  const waitForGroupsThenApply = (source) => {\n    let attempt = 0;\n    const check = () => {\n      attempt++;\n      const groupsStr =  _satellite.getVar('OneTrust Consent: Performance&Analytics');\n      \n      \n      \n     _satellite.logger.log(\"========= OneTrust Active groups init -> \" + groupsStr );\n      if (typeof groupsStr === \"string\" && groupsStr) {\n        applyFromGroups(groupsStr, source);\n        return;\n      }\n      if (attempt < maxAttempts) {\n        _satellite.logger.log(\"========= Wait Logic attempt -> \" + attempt);\n        setTimeout(check, interval);\n        \n        return;\n      } else {\n          _satellite.logger.log(\"One Trust Consent is not available, so using the geo location default\");\n          const geoConsent = _satellite.getVar('OneTrust Consent: Geo Location');\n          if(geoConsent === \"in\" || geoConsent === \"out\"){\n            _satellite.logger.log(\"One Trust using the geo location consent--\" + geoConsent);\n            applyFromGroups(groupsStr, source);\n            \n          } else if(geoConsent === \"pending\"){\n           _satellite.logger.log(\"One Trust using the geo location consent--\" + geoConsent);  \n             applyFromGroups(\"out\", source);\n          }else{\n            _satellite.logger.log(\"One Trust Geo Location is not available so sending the default status -- Out\");\n            applyFromGroups(\"out\", source);\n            \n          }\n\n        }\n\n      // if OneTrust never populated it, default to Out\n      applyFromGroups(\"\", source + \" (timeout)\");\n    };\n    check();\n  };\n\n  // 1) Fires on initial OneTrust initialization (page load)\n   waitForGroupsThenApply(\"init:\");\n\n\n  // 2) Fires when user updates/changes consent\n  window.addEventListener(\"OneTrustGroupsUpdated\", () => {\n    _satellite.logger.log(\"OneTrustGroupsUpdated fired\");\n    waitForGroupsThenApply(\"updated:\");\n   \n\n  });\n})();");