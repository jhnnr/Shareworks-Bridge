    "URL": {
      "defaultValue": "",
      "forceLowerCase": true,
      "storageDuration": "pageview",
      "modulePath": "core/src/lib/dataElements/customCode.js",
      "settings": {
        "source": function(event) {
  try{
function fnProtectUrl(strActualURL)
        {
            if(strActualURL.indexOf('?') < 0) return strActualURL;
            
            var strUrlEnd = '';
            var strUrl = strActualURL.substring(0, strActualURL.indexOf('?'));
            var strQuery = strActualURL.substring(strActualURL.indexOf('?') + 1);
            if(strQuery.indexOf('#/') > 0)
            {
                strUrlEnd = strQuery.substring(strQuery.lastIndexOf('#/'));
                strQuery = strQuery.substring(0, strQuery.lastIndexOf('#/'));
            }
            else if(strQuery.indexOf('/') > 0)
            {
                strUrlEnd = strQuery.substring(strQuery.lastIndexOf('/'));
                strQuery = strQuery.substring(0, strQuery.lastIndexOf('/'));
            }
            var strQueryArray = strQuery.split('&');
            
            //param exceptions require an extra comma at the end or will not work
            var exceptP = ',mid,icid,et_mkid,et_mid,cid,mkwid,adobe_mc,goto,inav,'.toLowerCase();
            var param, paramV;
            var i=0;
            var strFinalUrl = strUrl + '?';
            if(strQueryArray.length > 0)
            {
                param = strQueryArray[i].substring(0, strQueryArray[i].indexOf('='));
                if(exceptP.indexOf(',' + param.toLowerCase() + ',') > -1)
                {
                    paramV = strQueryArray[i].substring(strQueryArray[i].indexOf('=') + 1);
                    strFinalUrl += param + '=' + paramV;
                }
                else
                    strFinalUrl += param + '=' + param + 'redacted';
               }
            
            for(i=1; i<strQueryArray.length; i++)
            {
                param = strQueryArray[i].substring(0, strQueryArray[i].indexOf('='));
                if(exceptP.indexOf(',' + param.toLowerCase() + ',') > -1)
                {
                    paramV = strQueryArray[i].substring(strQueryArray[i].indexOf('=') + 1);
                    strFinalUrl += '&' + param + '=' + paramV;
                    }
                else
                    strFinalUrl += '&' + param + '=' + param + 'redacted';        
            }
            
            strFinalUrl += strUrlEnd;
            return strFinalUrl;
        }
        
       return fnProtectUrl(window.location.href);
    }
   catch(err){
   console.log("error in URL Data Element" + err);
    }
}
      }
    },
    "OneTrust Consent: Geo Location": {
      "cleanText": true,
      "modulePath": "core/src/lib/dataElements/customCode.js",
      "settings": {
        "source": function(event) {
  try{
  if(!(typeof window.OneTrust?.getGeolocationData === 'function' && window.OneTrust?.getGeolocationData().country)){
    return null;
  }
  
  const country = window.OneTrust.getGeolocationData().country.toUpperCase();
  const state = window.OneTrust.getGeolocationData().state?.toUpperCase() ?? "";
  const gpcValue = _satellite.getVar("Function: Cookie Attribute Value")("OptanonConsent","isGpcEnabled") ?? 0;
  const countryDefault = ['US']; // If the country is US then the default consent is in for all states except California
  const stateDefault = ['CA']; //The default consent for california is Out
  //console.log("=====**== Values in order"+ country + state + "==" +gpcValue);
  return countryDefault.includes(country) ? (stateDefault.includes(state) && gpcValue==='1' ? "pending" : "in") : "out";
  
}catch(error){
 // console.log("Error in OneTrust Consent: Geo Location Data Element ::" + error);
  return "out"; //Default Consent as Out incase if there is any error
}
}
      }
    },
