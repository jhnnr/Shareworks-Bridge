    "launch details": {
      "forceLowerCase": true,
      "cleanText": true,
      "modulePath": "core/src/lib/dataElements/customCode.js",
      "settings": {
        "source": function(event) {
  // Check if the AppMeasurement object is defined

if (typeof window.s !== 'undefined') {
  // Check if the version property is available
  if (typeof window.s.version !== 'undefined') {
     // Get Adobe Launch property name
  var propertyName = _satellite.property.name;
  
  // Get Visitor ID
  var visitorIdVersion = _satellite.getVisitorId().version;
  
  // Get Property ID
  var propertyId = _satellite.property;

  // Get Property Publish Date
  var propertyPublishDate = _satellite.buildInfo;
    // Print the AppMeasurement.js version
    var AppMeasurementVersion = window.s.version;
     
    var launchDetails=propertyName+"|"+AppMeasurementVersion+"|"+visitorIdVersion+"|"+_satellite.buildInfo.buildDate;
    
    return launchDetails;
    
  } else {
    return launchDetails;
    
  }
} else {
  return launchDetails;
  
}


}
