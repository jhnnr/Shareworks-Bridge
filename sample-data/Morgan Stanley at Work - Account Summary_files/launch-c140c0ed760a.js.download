    "OneTrust Consent: Performance&Analytics": {
      "modulePath": "core/src/lib/dataElements/customCode.js",
      "settings": {
        "source": function(event) {
  try{
  //If One Trust Script is not loaded on the page then we will return the consent as In
  if(typeof window.OneTrust === 'undefined' && typeof window.OnetrustActiveGroups === 'undefined' && typeof window.OptanonWrapper !== 'function'){
    return "in";
  }
  //If One Trust Script is loaded but activeGroups are not set then return null for to wait till it is set
  const activeGroups = window.OnetrustActiveGroups || '';
  
  _satellite.logger.log("OnetrustActiveGroups  " + activeGroups);
  
  //If One Trust Script is loaded but activeGroups are not set then check for optanon cookie as well.
  const optanonCookie = _satellite.cookie.get("OptanonConsent") || '';
  
  if(!(activeGroups && activeGroups?.includes('C0001')) && !(optanonCookie && optanonCookie?.includes('C0001'))){
    return null;
  }
  //If the value is set then return the consent status
  _satellite.logger.log("printing the optanon cookie" + optanonCookie)
  const hasConsent=activeGroups?.includes('C0002') || optanonCookie?.includes('C0002:1');
  return hasConsent? "in" : "out";
  
} catch(error){
  _satellite.logger.log("Error in OneTrust Consent: Performance&Analytics Data Element ::" + error);
  return "out"; //Default Consent as Out incase if there is any error
}
}
      }
    },
