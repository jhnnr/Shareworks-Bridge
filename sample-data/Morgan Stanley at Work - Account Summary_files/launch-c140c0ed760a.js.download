  var hourOfDay = hours+ampm; */
  
 var timeObj = getTimeParting("America/New_York");
 var timeObjSplit = timeObj.split('|');
 var dayOfWeek = timeObjSplit[3].split('=')[1];
 //DAY TYPE
  var dayType = 'weekday';
  if(dayOfWeek.includes('Saturday')||dayOfWeek.includes('Sunday')) dayType = 'weekend';
  //HOUR
  var time = timeObjSplit[4];
  var hoursFirst = time.split('=')[1];
  var hours = hoursFirst.split(':')[0];
  var ampm = hoursFirst.split(' ')[1];
  var hourOfDay = hours+ampm;
  
  //SET TIME DETAILS
  s.eVar1 = s.prop2 = hourOfDay;
  s.eVar2 = s.prop3 = dayOfWeek;
  s.eVar3 = s.prop4 = dayType;
  
  /************************** PII Redaction **************************/
 var redactedParams = ""; 
  function redactPII(param) {
     // Regular expression to match email, phone number, SSN
     const piiRegex = /(?:\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,})|(\+?\d{1,3}\s?)?[\s.-]?\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}|(\d{9,11})|(?:(\d{3}[ .-]?)(\d{2}[ .-]?)(\d{4}[ .-]?))/g;

   
     // Replace all instances of PII with "redacted"
    if(typeof(s[param]) === 'string'&& s[param].match(piiRegex)){
       s[param]= 'redacted';
       redactedParams += param + ", "; 
    }
 }
  // Function to apply redaction logic to all eVars/props in the s object
 function redactAllEvars(s) {
     let exemptEvars = [15,17,32,35,37,47,68,73,81,100,107,115,120]; 
     let exemptProps = [1,12,42,47,53];
    
     // Loop through eVars from 1 to 75
     for (let i = 1; i <= 250; i++) {
         // Check if the eVar is defined and has a value
         if (s['eVar' + i] && !exemptEvars.includes(i)) {
             redactPII('eVar' + i);
         }
       //check if the prop defined has a value
         if (s['prop' + i] && !exemptProps.includes(i)) {
           redactPII('prop' + i);
         }
     }
     for (let j =1; j<=3; j++){
       if(s['list' + j]){
         redactPII('list' + j);
       }
     }
   
   redactedParams = redactedParams.replace(/, $/, '');
   s.eVar25 = redactedParams;
   return s;
 }
  redactAllEvars(s);
}

s.doPlugins=s_doPlugins;

