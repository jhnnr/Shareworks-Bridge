_satellite.__registerScript('https://assets.adobedtm.com/b124caa02ab9/3e36902c0620/207482a4df9e/RCf682c4181c334699b0ea5026a563d1f7-source.js', "//var OneTrustConsentValue = _satellite.getVar('One_Trust_Consent2');\n(function () {\n    const maxAttempts = 10;\n    const interval = 100;\n\n    let attempt = 0;\n    let timer = null;\n    let completed = false;\n    let isFirstPageView = false;\n\n    const consent = (status) => {\n        if(!completed){\n            completed = true;\n            if(timer){\n                clearTimeout(timer);\n                timer = null;\n            }\n            alloy(\"setConsent\", { consent: [\n                {\n                standard: \"Adobe\",\n                version: \"1.0\",\n                    value: {\n                        general: status\n                    }\n                }\n            ]}).then(function(){\n          if(status === \"out\"){\n            deleteCookies();\n          }\n              });\n        }\n    }\n    \n    const validate = () => {\n        attempt ++;\n        \n        const status = _satellite.getVar('OneTrust Consent: Performance&Analytics');\n        _satellite.logger.log(\"validate function called--\" + attempt+\"--\"+status+\"OnetrustActiveGroups--\"+window.OnetrustActiveGroups);\n\n        if(status === \"in\" || status === \"out\"){\n            consent(status);\n            if(status === \"in\" && !isFirstPageView){\n              isFirstPageView = true;\n            }\n            return;\n        }\n\n        if(attempt < maxAttempts){\n          timer = setTimeout(validate, interval); \n          _satellite.logger.log(\"checking time\" + attempt);\n        }else{\n          _satellite.logger.log(\"One Trust Consent is not available, so using the geo location default\");\n          const geoConsent = _satellite.getVar('OneTrust Consent: Geo Location');\n          if(geoConsent === \"in\" || geoConsent === \"out\"){\n            if(status === \"in\" && !isFirstPageView){\n              isFirstPageView = true;\n            }\n            _satellite.logger.log(\"One Trust using the geo location consent--\" + geoConsent);\n            consent(geoConsent);\n            return;\n          } else if(geoConsent === \"pending\"){\n           _satellite.logger.log(\"One Trust using the geo location consent--\" + geoConsent);\n            consent(geoConsent);\n            return;\n          }else{\n            _satellite.logger.log(\"One Trust Geo Location is not available so sending the default status -- Out\");\n            consent(\"out\");\n            return;\n          }\n\n        }\n    }\n    /*\n    const deleteCookies = () => {\n      let domain = \".\"+window.location.hostname.split('.').slice(-2).join('.');\n      console.log(\"deleting cookies--\");\n    document.cookie.split(\";\").forEach(function (c) {\n     \n      var name= c.split(\"=\")[0].trim();\n      if (name.indexOf(\"kndctr_\")===0 || name.indexOf(\"AMCV_\")===0 || name.indexOf(\"AMCVS_\")===0)\n        {\n          console.log(\"deleting cookies names--\"+name);\n          document.cookie= name+ \"=; max-age=0; path=/; domain=\"+ domain;\n        }\n   });\n  }\n*/\n    const deleteCookies = () => {\n\n  //console.log(\"Deleting consent cookies\");\n\n  document.cookie.split(\";\").forEach(function (c) {\n\n    const name = c.split(\"=\")[0].trim();\n\n    if (\n      name.indexOf(\"kndctr_\") === 0 ||\n      name.indexOf(\"AMCV_\") === 0 ||\n      name.indexOf(\"AMCVS_\") === 0\n    ) {\n\n     // console.log(\"Deleting:\", name);\n\n      // Current hostname\n      const hostname = window.location.hostname;\n\n      // Delete without domain\n      document.cookie =\n        name + \"=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\n\n      // Delete with hostname\n      document.cookie =\n        name +\n        \"=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=\" +\n        hostname + \";\";\n\n      // Delete with root domain\n      const rootDomain =\n        \".\" + hostname.split(\".\").slice(-2).join(\".\");\n\n      document.cookie =\n        name +\n        \"=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=\" +\n        rootDomain + \";\";\n\n      //console.log(\"Delete attempted for:\", name);\n    }\n  });\n};\n\n    window.addEventListener(\"OneTrustGroupsUpdated\", (event) => {\n      _satellite.logger.log(\"oneTrustGroupsUpdated event is detected\");\n      \n      const status = _satellite.getVar('OneTrust Consent: Performance&Analytics');\n      if(status === \"in\" || status === \"out\"){\n        completed = false;\n        consent(status);\n        /*if(status === \"in\" && !isFirstPageView){\n           isFirstPageView = true;\n          _satellite.track(\"page_load\");\n          console.log(\"One Trust After default beacon--\" + isFirstPageView);\n        }\n      }\n      console.log(\"One Trust before default beacon--\" + isFirstPageView);\n*/\n      }\n    });\n\n    validate();\n\n})();\n");